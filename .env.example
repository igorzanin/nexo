# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (produção recomendada)
DATABASE_URL=postgresql+psycopg2://nexo:nexo@localhost:5432/nexo
# SQLite (fallback local — basta trocar a URL acima)
# DATABASE_URL=sqlite:///./nexo.db

# ─── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=TROQUE-ANTES-DE-SUBIR-EM-PRODUCAO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Upload ─────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ─── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ─── Observabilidade ────────────────────────────────────────────────────────────
# LOG_LEVEL=info
# ENABLE_METRICS=true
