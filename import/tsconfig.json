{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "util/*.ts",
    "trello/importTrello.ts",
    "jira/jiraImporter.ts",
    "asana/importAsana.ts",
    "todoist/importTodoist.ts",
    "notion/importNotion.ts",
    "nextcloud-deck/importDeck.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
